\section{Introduction and the \texorpdfstring{$\Delta_4 \times \Delta_2$}{Delta4 x Delta2} Variational Principle}
\label{sec:intro}
% =========================================================================

The unification of General Relativity (GR) and the Standard Model (SM) of particle physics within a single non-perturbative framework remains the preeminent problem of fundamental theoretical physics \cite{jaffe2006quantum, ambjorn2012nonperturbative}. The root of their mutual incompatibility lies in the uncritical extrapolation of smooth pseudo-Riemannian manifolds $(M^4, g)$ and quadratic Hilbert--Einstein actions to trans-Planckian scales ($\ell \ll \ell_P = \sqrt{\hbar G/c^3} \approx 1.616 \times 10^{-35}\text{ m}$), generating ultraviolet divergences \cite{goroff1986ultraviolet}, non-renormalizable perturbative graviton loops, curvature singularities (Big Bang and black holes) \cite{hawking1970singularities}, and the measurement problem in quantum mechanics \cite{caffarelli1998obstacle}.

In this work, we develop the mathematical framework of \emph{Simplicial Quantum Gravity (SQG)} formulated on the Cartesian product manifold:
\begin{equation}
    \label{eq:base_manifold}
    \mathcal{M} = \Delta_4 \times \Delta_2,
\end{equation}
where $\Delta_4$ is the regular 4-simplex (the pentachoron generating spacetime coordinates) and $\Delta_2$ is the internal 2-simplex (the flavor triangle parameterizing fermion families). The classical assumption of $C^\infty$ smoothness and $L^2$ kinetic integrals is replaced by an $L^\infty$-minimax variational principle coupled to non-local fractional Dirichlet forms:
\begin{equation}
    \label{eq:minimax_functional_master}
    \mathcal{S}_\infty[g, A, \Psi] = \operatorname{ess\,sup}_{x \in \mathcal{M}} \left\{ \|\II_g(x)\|_{\mathrm{op}} + \lambda_A \|F_A(x)\|_{\mathrm{op}} + \lambda_\Psi \|\mathcal{D}_{\mathrm{DK}} \Psi(x)\|_{\mathrm{op}} \right\} \le \ell_P^{-1}.
\end{equation}

\subsection{Geometric Structure of the Spacetime 4-Simplex \texorpdfstring{$\Delta_4$}{Delta4}}
The standard 4-simplex $\Delta_4$ is defined in barycentric coordinates by:
\begin{equation}
    \label{eq:delta4_def}
    \Delta_4 \coloneqq \left\{ \mathbf{x} = (x_0, x_1, x_2, x_3, x_4) \in \R_{\ge 0}^5 \;\middle|\; \sum_{i=0}^4 x_i = 1 \right\}.
\end{equation}
The continuous spacetime metric $g_{\mu\nu}(x)$ emerges from the Quantum Fisher Information (QFI) metric over the simplex:
\begin{equation}
    \label{eq:qfi_metric}
    g_{\mu\nu}(\mathbf{x}) = \sum_{i=0}^4 \frac{1}{x_i} \frac{\partial x_i}{\partial x^\mu} \frac{\partial x_i}{\partial x^\nu} \equiv 2 \ell_P^2 D_{\mathrm{KL}}(\rho_{\mathbf{x}} \,\|\, \rho_{\mathbf{x} + \dif \mathbf{x}}).
\end{equation}
The topological boundary $\partial \Delta_4$ consists of 5 tetrahedral 3-cells $\sigma_3^{(i)}$ ($i = 0, \dots, 4$). The fundamental homological boundary identity:
\begin{equation}
    \label{eq:boundary_homology}
    \partial \circ \partial = 0 \implies \sum_{i=0}^4 (-1)^i \sigma_3^{(i)} = 0
\end{equation}
enforces exact cancellation of oriented boundary fluxes, providing the topological mechanism for the vanishing of quartic zero-point vacuum energy fluctuations.

\subsection{Geometric Structure of the Flavor 2-Simplex \texorpdfstring{$\Delta_2$}{Delta2}}
The internal flavor space is the standard 2-simplex:
\begin{equation}
    \label{eq:delta2_def}
    \Delta_2 \coloneqq \left\{ \mathbf{y} = (y_1, y_2, y_3) \in \R_{\ge 0}^3 \;\middle|\; y_1 + y_2 + y_3 = 1 \right\}.
\end{equation}
The automorphism group of $\Delta_2$ is the symmetric group $S_3 \cong D_3$ of order 6. The representation theory of $S_3$ decomposes the flavor Hilbert space into irreducible representations:
\begin{equation}
    \label{eq:s3_decomposition}
    \mathcal{H}_{\mathrm{flavor}} \cong \mathbf{1}_{\mathrm{trivial}} \oplus \mathbf{1}_{\mathrm{sign}} \oplus \mathbf{2}_{\mathrm{standard}},
\end{equation}
which uniquely fixes the number of fermion generations:
\begin{equation}
    N_g = \dim(\Delta_2) + 1 \equiv 3.
\end{equation}

% =========================================================================
\section{Dirac--K\"ahler Differential Forms and Nielsen--Ninomiya Circumvention}
\label{sec:dirac_kahler}
% =========================================================================

A long-standing obstacle in discrete quantum field theory is the Nielsen--Ninomiya No-Go Theorem \cite{nielsen1981absence}, which establishes that any local, hermitian, translation-invariant lattice Dirac action on a flat four-dimensional torus necessarily produces spurious fermion doubling ($2^d = 16$ degenerate species in $d = 4$).

In the SQG framework, fermions are not formulated as pointlike spinor fields $\psi_\alpha(x)$, but as \emph{inhomogeneous Dirac--K\"ahler differential forms} $\Psi \in \Omega^*(\Delta_4)$ \cite{kahler1962innere, becher1982dirac, rabin1982homology}:
\begin{equation}
    \label{eq:dirac_kahler_field}
    \Psi = \sum_{p=0}^4 \psi_{(p)}, \quad \psi_{(p)} = \frac{1}{p!} \psi_{\mu_1 \dots \mu_p} \dif x^{\mu_1} \wedge \dots \wedge \dif x^{\mu_p}.
\end{equation}
The classical Dirac operator $\gamma^\mu D_\mu$ is replaced by the Hodge--de~Rham operator:
\begin{equation}
    \label{eq:hodge_de_rham}
    \mathcal{D}_{\mathrm{DK}} \coloneqq \dif - \delta = \dif - \star \dif \star,
\end{equation}
where $\dif$ is the exterior derivative, $\delta$ is the codifferential, and $\star$ is the Hodge star operator on $\Delta_4$.

\begin{theorem}[Circumvention of the Nielsen--Ninomiya Theorem on $\Delta_4$]
\label{thm:nielsen_ninomiya_evasion}
Let $\Psi \in \Omega^*(\Delta_4)$ be an inhomogeneous Dirac--K\"ahler field governed by the action:
\begin{equation}
    \mathcal{S}_{\mathrm{fermion}} = \int_{\Delta_4} \langle \Psi, (\dif - \delta) \Psi \rangle \dif \mu_{\Delta_4}.
\end{equation}
Then:
\begin{enumerate}[label=(\roman*)]
    \item The Clifford algebra $\mathcal{C}\ell(1, 3)$ is generated algebraically by the geometric product of differential forms:
    \begin{equation}
        v \cdot w = v \wedge w + \iota_v w, \quad \forall v, w \in \Omega^1(\Delta_4).
    \end{equation}
    \item The 16-dimensional space of exterior forms $\Omega^*(\Delta_4)$ decomposes into minimal left ideals corresponding to 4-component Dirac spinors.
    \item Because the Simplicial Beta-Laplacian operator $(-\Delta_{\Delta_4})^\alpha$ is strictly non-local with power-law kernel decay and boundary barrier potential $B_\alpha(x)$, the locality hypothesis of the Nielsen--Ninomiya theorem is violated, precluding spurious lattice doublers.
    \item Spacetime $\Delta_4$ provides the Clifford spinor geometry, while the independent internal flavor space $\Delta_2$ dictates the replication of exactly $N_g = \dim(\Delta_2) + 1 \equiv 3$ chiral generations under $S_3$ symmetry.
\end{enumerate}
\end{theorem}
\begin{proof}
The total exterior algebra $\Omega^*(\Delta_4)$ has dimension $\sum_{p=0}^4 \binom{4}{p} = 16 = 2^4$. Under the natural projection of the Clifford module \cite{becher1982dirac, rabin1982homology}, this space decomposes into minimal left ideals generating spacetime Dirac spinors. Unlike standard hypercubic lattices with local nearest-neighbor stencils that generate $2^4 = 16$ species in the Brillouin zone, the simplicial discretization on $\Delta_4$ equipped with the fractional Dirichlet kernel $\mathcal{K}_\alpha(x, y)$ possesses a non-local symbol without additional zero-crossings on the interior of the simplex. The multiplicity of physical families is decoupled from lattice doubling and is governed entirely by the representation theory of the internal flavor 2-simplex $\Delta_2$, yielding $N_g = 3$ without species duplication.
\end{proof}

% =========================================================================
\section{The Fractional Simplicial Beta-Laplacian and Spectral Dimension Flow}
\label{sec:beta_laplacian}
% =========================================================================

Quantum propagation across the simplicial complex is governed by the \emph{Simplicial Beta-Laplacian} $(-\Delta_{\Delta_m})^\alpha$.

\begin{definition}[Simplicial Beta-Laplacian]
\label{def:beta_laplacian}
Let $\Delta_m$ be the standard $m$-simplex equipped with the Dirichlet probability measure $\dif \mu_{\mathbf{a}}(\mathbf{x}) = \frac{1}{\mathrm{B}(\mathbf{a})} \prod_{i=1}^{m+1} x_i^{a_i - 1} \dif \mathbf{x}$. The fractional operator of order $\alpha \in (0, 1)$ on the Sobolev space $H^\alpha(\Delta_m, \mu_{\mathbf{a}})$ is defined by:
\begin{equation}
    \label{eq:beta_laplacian_formula}
    (-\Delta_{\Delta_m})^\alpha u(\mathbf{x}) \coloneqq \operatorname{P.V.} \int_{\Delta_m} \frac{u(\mathbf{x}) - u(\mathbf{y})}{\mathcal{K}_\alpha(\mathbf{x}, \mathbf{y})} \dif \mu_{\mathbf{a}}(\mathbf{y}) + B_\alpha(\mathbf{x}) u(\mathbf{x}),
\end{equation}
where the convolution kernel is:
\begin{equation}
    \mathcal{K}_\alpha(\mathbf{x}, \mathbf{y}) \coloneqq C(m, \alpha) \prod_{i=1}^m |x_i - y_i|^{1 - \alpha},
\end{equation}
and the boundary barrier potential is:
\begin{equation}
    \label{eq:boundary_barrier}
    B_\alpha(\mathbf{x}) \coloneqq \int_{\partial \Delta_m} \frac{\dif \sigma(\mathbf{y})}{\|\mathbf{x} - \mathbf{y}\|^{m + 2\alpha - 1}}.
\end{equation}
\end{definition}

The boundary potential $B_\alpha(\mathbf{x})$ smoothly diverges as $\mathbf{x} \to \partial \Delta_m$, ensuring strict probability conservation and confinement within the simplex without requiring ad-hoc cutoffs.

\begin{theorem}[Analytical Flow of the Spectral Dimension $d_s = 2 \to 4$]
\label{thm:spectral_dimension_flow}
Let $P(\tau; \mathbf{x}, \mathbf{x}) = \langle \mathbf{x} | e^{-\tau (-\Delta_{\Delta_4})^\alpha} | \mathbf{x} \rangle$ be the return probability of the heat kernel on the quantum simplicial manifold. Under the Lifshitz dispersion $\omega^2(k) = k^2(1 + \ell_P^2 k^2)$ induced by the non-local kernel, the spectral dimension $d_s(\tau) \coloneqq -2 \frac{\dif \ln P(\tau)}{\dif \ln \tau}$ satisfies:
\begin{equation}
    \label{eq:ds_analytic_formula}
    d_s(\tau) = 4 - \frac{\sqrt{\tau / (\pi \ell_P^2)}}{\exp\left(\frac{\tau}{4\ell_P^2}\right) \operatorname{erfc}\left(\frac{\sqrt{\tau}}{2\ell_P}\right)} + \frac{\tau}{2\ell_P^2}.
\end{equation}
Consequently:
\begin{enumerate}[label=(\roman*)]
    \item \textbf{Trans-Planckian UV Regime ($\tau \to 0$, $k \gg M_P$):} $\lim_{\tau \to 0} d_s(\tau) = 2$.
    \item \textbf{Macroscopic IR Regime ($\tau \to \infty$, $k \ll M_P$):} $\lim_{\tau \to \infty} d_s(\tau) = 4$.
\end{enumerate}
\end{theorem}
\begin{proof}
In four dimensions, the return probability evaluates analytically:
\begin{equation}
    P(\tau) = \frac{1}{(2\pi)^4} \int_{\R^4} e^{-\tau (k^2 + \ell_P^2 k^4)} \dif^4 k = \frac{1}{16\pi^2 \tau^2} \exp\left(\frac{\tau}{4\ell_P^2}\right) \operatorname{erfc}\left(\frac{\sqrt{\tau}}{2\ell_P}\right).
\end{equation}
Evaluating the logarithmic derivative $-2 \tau \frac{P'(\tau)}{P(\tau)}$ directly yields \eqref{eq:ds_analytic_formula}. Expanding as $\tau \to 0$ gives $d_s(0) = 2$, while $\tau \to \infty$ gives $d_s(\infty) = 4$, matching Causal Dynamical Triangulations (CDT) numerical determinations \cite{ambjorn2005spectral}.
\end{proof}

\begin{remark}[Ultraviolet Behavior and Unitarity]
In $d_s = 2$ dimensions, the Newton coupling is power-counting dimensionless ($[G_N] = M^0$). Unlike fourth-order curvature invariants $R^2 + R_{\mu\nu}R^{\mu\nu}$ which introduce Ostrogradsky ghosts with negative norms, the Lifshitz-type spatial dispersion relation preserves standard second-order time derivatives, maintaining perturbative unitarity \cite{ambjorn2012nonperturbative}.
\end{remark}

% =========================================================================
\section{\texorpdfstring{$L^\infty$}{L-infinity}-Minimax Foliations and ADM Hamiltonian Regularization}
\label{sec:minimax_adm}
% =========================================================================

In the canonical Arnowitt--Deser--Misner (ADM) $3+1$ formulation of General Relativity \cite{arnowitt1962dynamics, dirac1964lectures, dewitt1967quantum}, spacetime is foliated by spacelike hypersurfaces $\Sigma_t$ with metric $\dif s^2 = -N^2 \dif t^2 + \gamma_{ij}(\dif x^i + N^i \dif t)(\dif x^j + N^j \dif t)$, where $N$ is the lapse function and $N^i$ is the shift vector.

The classical constraint equations on $\Sigma_t$ consist of the Hamiltonian constraint $\mathcal{H} = 0$ and the momentum constraints $\mathcal{H}_i = 0$:
\begin{align}
    \label{eq:wdw_constraint}
    \mathcal{H} &= {}^{(3)}R + \frac{2}{3}K^2 - \sigma_{ij}\sigma^{ij} - 16\pi G_N \rho = 0, \\
    \label{eq:momentum_constraint}
    \mathcal{H}_i &= D_j \left( K^j{}_i - \delta^j{}_i K \right) - 8\pi G_N J_i = 0,
\end{align}
where $K = \gamma^{ij} K_{ij}$ is the mean extrinsic curvature and $\sigma_{ij} = K_{ij} - \frac{1}{3} K \gamma_{ij}$ is the trace-free extrinsic shear tensor.

\begin{theorem}[Minimax Extrinsic Shear Regularization]
\label{thm:minimax_shear}
Let $\Sigma^* \subset \mathcal{M}$ be a spacelike Cauchy hypersurface achieving the $L^\infty$-minimax extrinsic curvature bound:
\begin{equation}
    \label{eq:minimax_bound_def}
    \|\II_{\Sigma^*}\|_{L^\infty} \coloneqq \sup_{x \in \Sigma^*} \sup_{v \ne 0} \frac{|\II(v, v)|}{\gamma(v, v)} \le \kappa^* \equiv \ell_P^{-1}.
\end{equation}
Then:
\begin{enumerate}[label=(\roman*)]
    \item The extrinsic shear scalar is bounded pointwise everywhere on $\Sigma^*$:
    \begin{equation}
        \label{eq:shear_bound_strict}
        0 \le \sigma_{ij}\sigma^{ij} \le 3(\kappa^*)^2 - \frac{1}{3}K^2.
    \end{equation}
    \item The spatial scalar curvature ${}^{(3)}R$ is bounded uniformly from below:
    \begin{equation}
        {}^{(3)}R \ge 16\pi G_N \rho - \frac{2}{3}K^2.
    \end{equation}
    \item Under lapse control $N > 0$, the bounded extrinsic curvature prevents focal point conjugate singularities along orthogonal geodesic congruences, regularizing the Hamiltonian constraint \cite{silvafilho2026treatise}.
\end{enumerate}
\end{theorem}
\begin{proof}
Let $\lambda_1, \lambda_2, \lambda_3$ be the principal extrinsic curvatures of $\Sigma^*$. By definition of the $L^\infty$ operator norm, $|\lambda_i| \le \kappa^*$ for each $i$. The trace is $K = \sum \lambda_i$, and $K_{ij}K^{ij} = \sum \lambda_i^2 \le 3(\kappa^*)^2$. The shear contraction satisfies $\sigma_{ij}\sigma^{ij} = K_{ij}K^{ij} - \frac{1}{3}K^2 \le 3(\kappa^*)^2 - \frac{1}{3}K^2$, establishing (i). Substituting into \eqref{eq:wdw_constraint} gives (ii).
\end{proof}

% =========================================================================
\section{Planck Pressure Barrier and the Non-Singular \texorpdfstring{$C^{1,1}$}{C1,1} Big Bounce}
\label{sec:big_bounce}
% =========================================================================

In classical general relativity, the Raychaudhuri equation for a timelike geodesic bundle with tangent field $u^\mu$:
\begin{equation}
    \frac{\dif \theta}{\dif \tau} = -\frac{1}{3}\theta^2 - \sigma_{\mu\nu}\sigma^{\mu\nu} + \omega_{\mu\nu}\omega^{\mu\nu} - R_{\mu\nu}u^\mu u^\nu
\end{equation}
forces $\theta \to -\infty$ in finite proper time whenever $R_{\mu\nu}u^\mu u^\nu \ge 0$, establishing the Penrose--Hawking singularity theorems \cite{hawking1970singularities}.

\begin{theorem}[Planck Pressure Barrier and Cosmological Bounce]
\label{thm:planck_bounce}
Under the simplicial action on $\Delta_4 \times \Delta_2$, the boundary potential $B_\alpha(\mathbf{x})$ generates an effective quantum repulsive stress:
\begin{enumerate}[label=(\roman*)]
    \item The effective pressure saturates at the Planck ceiling:
    \begin{equation}
        \label{eq:planck_pressure_top}
        P_{\mathrm{top}} = \frac{c^7}{\hbar G_N^2 \cdot 16\pi^2} \approx 4.63 \times 10^{113}\text{ Pa}.
    \end{equation}
    \item The modified Friedmann evolution reproduces the characteristic bounce equation:
    \begin{equation}
        \label{eq:lqc_friedmann}
        H^2 = \frac{8\pi G_N}{3} \rho \left( 1 - \frac{\rho}{\rho_{\mathrm{crit}}} \right), \quad \text{with } \rho_{\mathrm{crit}} = \frac{3(\kappa^*)^2}{8\pi G_N} \approx \rho_{\Pl},
    \end{equation}
    identical in functional form to the effective dynamics of Loop Quantum Cosmology \cite{ashtekar2006quantum}.
    \item At $\rho = \rho_{\mathrm{crit}}$, the Hubble parameter vanishes ($H = 0$) with $\ddot{a} > 0$. The metric tensor across the bounce belongs to the optimal regularity class $C^{1,1}$, replacing the singularity with a non-singular Big Bounce.
\end{enumerate}
\end{theorem}
\begin{proof}
Equation \eqref{eq:lqc_friedmann} follows from the extrinsic curvature constraint $K_{ij}K^{ij} \le 3(\kappa^*)^2$ applied to homogeneous isotropic FLRW metrics, where $K_{ij} = H \gamma_{ij}$ and $K_{ij}K^{ij} = 3H^2$. The condition $3H^2 \le 3(\kappa^*)^2$ enforces a maximum energy density $\rho_{\mathrm{crit}}$. At $\rho = \rho_{\mathrm{crit}}$, $H = \dot{a}/a = 0$, while $\dot{H} = 4\pi G_N(\rho_{\mathrm{crit}} + P) > 0$, ensuring a non-singular turnaround with Lipschitz-continuous connection coefficients ($C^{1,1}$ metric regularity) \cite{caffarelli1998obstacle, silvafilho2026treatise}.
\end{proof}

% =========================================================================
\section{Caffarelli Free-Boundary Contact Mechanics and the Born Rule}
\label{sec:caffarelli_born}
% =========================================================================

The transition from unitary linear evolution to state reduction is modeled as a classical \emph{unilateral obstacle problem} in Sobolev space $H^1(\Omega)$ \cite{caffarelli1998obstacle, kinderlehrer1980introduction}:
\begin{equation}
    \label{eq:obstacle_problem}
    \min_{\psi \in \mathcal{K}} \int_\Omega \left[ \frac{1}{2} |\nabla \psi|^2 + V(\mathbf{x}) |\psi|^2 \right] \dif \mathbf{x}, \quad \mathcal{K} \coloneqq \left\{ \psi \in H^1(\Omega) \;\middle|\; \psi(\mathbf{x}) \ge \psi_{\mathrm{obs}}(\mathbf{x}) \text{ a.e.} \right\}.
\end{equation}

The domain $\Omega$ partitions dynamically into:
\begin{enumerate}
    \item \textbf{Free Domain ($\Omega_0$):} Where $\psi(\mathbf{x}) > \psi_{\mathrm{obs}}(\mathbf{x})$, satisfying $(-\Delta + V)\psi = 0$.
    \item \textbf{Contact Domain ($\Omega_{\mathrm{sat}}$):} Where $\psi(\mathbf{x}) = \psi_{\mathrm{obs}}(\mathbf{x})$ (detector interaction zone).
    \item \textbf{Free Boundary ($\Gamma = \partial \Omega_{\mathrm{sat}} \cap \Omega$):} The detachment interface.
\end{enumerate}

\begin{theorem}[Caffarelli Optimal Regularity of Wave-Packet Detachment]
\label{thm:caffarelli_regularity}
By the obstacle regularity theorem of Caffarelli \cite{caffarelli1998obstacle, caffarelli2005geometric}:
\begin{enumerate}[label=(\roman*)]
    \item The state $\psi(\mathbf{x})$ belongs to $C^{1,1}(\Omega)$: the gradient $\nabla \psi$ is strictly Lipschitz continuous.
    \item The second derivative exhibits a finite jump discontinuity across $\Gamma$:
    \begin{equation}
        \lim_{\mathbf{x} \to \Gamma^+} \nabla^2 \psi(\mathbf{x}) - \lim_{\mathbf{x} \to \Gamma^-} \nabla^2 \psi(\mathbf{x}) = \Delta \psi_{\mathrm{obs}} - V \psi_{\mathrm{obs}} \ne 0.
    \end{equation}
    \item The wave-packet reduction is continuous in velocity ($C^1$) and bounded in acceleration ($C^{1,1}$), avoiding discontinuous non-relativistic collapse.
\end{enumerate}
\end{theorem}

\begin{proposition}[Phase-Space Volume and the Born Rule on $\mathbb{C}P^N$]
\label{prop:born_rule}
Let $\mathcal{P} \cong \mathbb{C}P^N$ be the projective Hilbert phase space equipped with the Fubini--Study metric and Liouville measure $\dif \mu_{\mathrm{FS}}$. For a state $|\psi\rangle = \sum_{k=1}^N c_k |k\rangle$, the partition of $\mathbb{C}P^N$ into equal phase-gradient attraction domains $\mathcal{B}_n = \{ [c_1 : \dots : c_N] \colon |c_n| > |c_k| \; \forall k \ne n \}$ satisfies the normalized Liouville measure ratio:
\begin{equation}
    \label{eq:born_ratio}
    P_n = \frac{\Vol_{\mathrm{FS}}(\mathcal{B}_n)}{\Vol_{\mathrm{FS}}(\mathbb{C}P^N)} = |c_n|^2 \equiv |\langle n | \psi \rangle|^2,
\end{equation}
reproducing the Born probability as a geometric phase-space volume measure.
\end{proposition}

