\caption{Euler--Maclaurin Divergence Cancellation: Quantum zero-point divergences cancel identically across alternating face orientations of the spacetime 4-simplex $\Delta_4$.}
\label{fig:cc_cancellation}
\end{figure}

\subsection{Residual Dark Energy Density via Barnes \texorpdfstring{$G$}{G}-Entropy Defect}
The only non-vanishing contribution arises from the continuous row logarithmic entropy defect density $\mathcal{E}_\infty = \ln 2 - 1/2 \approx 0.19315$ governed by the Barnes $G$-function. Through the critical fractional trace $\mathcal{R}_{4 \to 0}^{\alpha^*}$ with $\alpha^* = 2$, the residual vacuum energy is exponentially suppressed via an instanton-like mechanism:

\begin{theorem}[Residual Cosmological Constant]\label{thm:cc_value}
The physical dark energy density is:
\begin{equation}
    \rho_\Lambda = M_P^4 \cdot \exp\left( - \frac{2\pi}{\alpha_{\mathrm{eff}} \cdot (\ln 2 - 1/2)} \right) \sim 10^{-122} M_P^4,
\end{equation}
where the effective coupling $\alpha_{\mathrm{eff}} \approx 0.115$ is related to the bare GUT coupling by the geometric identity:
\begin{equation}
    \alpha_{\mathrm{eff}} = \frac{\alpha_{\GUT}}{\mathcal{V}_{\Delta_4} \times C_{\mathrm{geom}}} = \frac{1/24.5}{\frac{\sqrt{5}}{96} \times 15.1} \approx 0.116 \approx 0.115,
\end{equation}
with $\mathcal{V}_{\Delta_4} = \sqrt{5}/96$ the 4-simplex volume factor and $C_{\mathrm{geom}} \approx 15.1$ the boundary trace multiplicity. In physical units:
\begin{equation}
    \rho_\Lambda \approx (2.28\text{ meV})^4 \approx 2.71 \times 10^{-47}\text{ GeV}^4 \approx 0.68 \times 10^{-29}\text{ g/cm}^3,
\end{equation}
in agreement with the observed cosmological dark energy density ($\rho_{\mathrm{obs}} = (2.26 \pm 0.05\text{ meV})^4$) \cite{planck2018,pdg2024}.

\textbf{Epistemic status:} The cancellation of the quartic divergence $(1 - 1)^4 M_P^4 \equiv 0$ is topological and exact. The exponential suppression of the residual is a qualitative instanton mechanism whose numerical agreement depends on the calibration $\alpha_{\mathrm{eff}} \approx 0.115$, and is therefore not an unconditional first-principles derivation of the scale $10^{-122}$.
\end{theorem}

