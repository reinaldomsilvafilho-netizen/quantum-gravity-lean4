        \bfseries Alternating Sum: $\displaystyle \sum_{k=0}^4 (-1)^k \binom{5}{k+1} = 1 - 5 + 10 - 10 + 5 - 1 \equiv 0 \implies \rho_{\mathrm{vac}}^{\mathrm{div}} \equiv 0$
    };
