% ==============================================================================
\section{The Flavor Simplex \texorpdfstring{$\Delta_2$}{Delta 2} and Complex Circulant Yukawa Matrices}
% ==============================================================================

\subsection{The 2-Simplex Boundary and Three Generations}
Let the spatial boundary at the electroweak scale be the 2-simplex $\Delta_2 = \{(x_1, x_2, x_3) \in \mathbb{R}_+^3 : x_1 + x_2 + x_3 = 1\}$. The standard 3D permutation representation of $S_3$ decomposes into irreducible components:
\begin{equation}
    V_{\mathrm{flavor}} \cong \mathbf{1} \oplus \mathbf{2},
\end{equation}
which topologically dictates that there are \textbf{identically three generations of elementary fermions}.

\subsection{Complex Circulant Yukawa Coupling}
Electroweak $\SU(2)_L \times \U(1)_Y$ gauge invariance restricts the Yukawa coupling matrix to the complex circulant family:
\begin{equation}\label{eq:circulant_Y}
    \mathbf{Y}_{\circm}(a, b, \delta) \coloneqq \begin{pmatrix}
        a & b e^{i\delta} & b e^{-i\delta} \\
        b e^{-i\delta} & a & b e^{i\delta} \\
        b e^{i\delta} & b e^{-i\delta} & a
    \end{pmatrix}, \quad a, b \in \mathbb{R}, \; \delta \in [0, 2\pi).
\end{equation}
The eigenvalues are given by $\lambda_k = a + 2b \cos\left( \delta + \frac{2\pi k}{3} \right)$ for $k \in \{0, 1, 2\}$.

% ==============================================================================
\section{Pillar I: The Charged Lepton Sector and Exact Koide Ratio \texorpdfstring{$K_l = 2/3$}{K = 2/3}}
% ==============================================================================

Charged leptons $(e, \mu, \tau)$ are $\SU(3)_c$ singlets. Upon electroweak symmetry breaking with Higgs vacuum expectation value $v = 246.22\text{ GeV}$, their mass matrix is $\mathbf{M}_l = \mathbf{Y}_l \frac{v}{\sqrt{2}}$.

\begin{theorem}[Geometric Parameter Reduction via Norm Equipartition]\label{thm:koide_exact}
The standard 3D permutation representation of $S_3$ decomposes canonically as $\R^3 \cong \mathbf{1} \oplus \mathbf{2}$. The mass root vector $\mathbf{v} = (\sqrt{m_e}, \sqrt{m_\mu}, \sqrt{m_\tau})$ decomposes as:
\begin{equation}
    \mathbf{v} = \underbrace{a(1, 1, 1)^T}_{\mathbf{v}_{\mathbf{1}} \in \mathbf{1}} + \underbrace{\mathbf{v}_{\mathbf{2}}}_{\in \mathbf{2}},
\end{equation}
where the singlet component $\mathbf{v}_{\mathbf{1}}$ fixes the family mass scale $v_0 = a$ and the doublet component $\mathbf{v}_{\mathbf{2}}$ lies in the trace-zero hyperplane $\sum x_k = 0$. The circulant orbit condition imposes norm equipartition:
\begin{equation}\label{eq:norm_equipartition}
    \|\mathbf{v}_{\mathbf{2}}\|^2 = \|\mathbf{v}_{\mathbf{1}}\|^2 \iff b/a = 1/\sqrt{2},
\end{equation}
which yields identically:
\begin{equation}
    \|\mathbf{v}\|^2 = \|\mathbf{v}_{\mathbf{1}}\|^2 + \|\mathbf{v}_{\mathbf{2}}\|^2 = 2\|\mathbf{v}_{\mathbf{1}}\|^2 = \frac{2}{3}\left(\sum_{k=0}^2 \sqrt{m_k}\right)^2 \implies Q_l \equiv \frac{2}{3}.
\end{equation}

\textbf{Epistemic status:} The model has 2 calibration parameters $(v_0, \delta_l)$ fitted against $(m_e, m_\mu)$, and delivers exactly 1 genuine prediction: $m_\tau \approx 1776.88\text{ MeV}$, compatible with the PDG value $1776.86 \pm 0.12\text{ MeV}$ within $0.012\sigma$.

Experimentally, with $m_e = 0.51099895\text{ MeV}$, $m_\mu = 105.6583755\text{ MeV}$, and $m_\tau = 1776.86\text{ MeV}$, $K_{\mathrm{exp}} = 0.66666051$, matching theory within $0.00092\%$.
\end{theorem}

% ==============================================================================
\section{Pillar II: The Quark Sector and Color-Flavor Entanglement}
% ==============================================================================

Quarks transform under the fundamental representation $\mathbf{3}$ of $\SU(3)_c$. The QCD radiative corrections at the electroweak scale $\mu = M_Z$ break the exact norm equipartition of the lepton sector, inducing a shift from $Q_l = 2/3$.

\begin{proposition}[Phenomenological QCD Scaling of Quark Koide Ratio]\label{prop:quark_koide}
At the renormalization scale $\mu = M_Z$, the quark Koide ratio for running masses is:
\begin{equation}
    Q_q \coloneqq \frac{\sum_{i=1}^3 m_{q_i}}{\left(\sum_{i=1}^3 \sqrt{m_{q_i}}\right)^2} \approx \frac{2}{3}\left( 1 + \frac{\alpha_s(M_Z)}{\sqrt{3}} \right) \approx 0.7121,
\end{equation}
in agreement with experimental running quark masses ($Q_q^{\mathrm{exp}} = 0.71 \pm 0.02$).

\textbf{Epistemic disclaimer:} The departure from the exact lepton value $Q_l = 2/3$ is attributed to the 1-loop Casimir gluon vertex correction with $C_2(F) = 4/3$. This is a phenomenological parametrization of the QCD radiative shift, not a first-principles derivation from the simplicial geometry alone.
\end{proposition}

% ==============================================================================
\section{Pillar III: The CKM Matrix and Geometric Derivation of the Cabibbo Angle}
% ==============================================================================

\begin{theorem}[Analytical Cabibbo Angle]\label{thm:cabibbo}
Projecting the barycentric centroid $\mathbf{x}_c = (1/3, 1/3, 1/3)$ of $\Delta_2$ onto the down-type flavor rays yields the geometric generalization of the Gatto--Sartori--Tonin relation \cite{cabibbo1963unitary,gatto1968relation}:
\begin{equation}
    \sin \theta_C = \sqrt{\frac{m_d}{m_s}} \cdot \left(1 + \frac{\alpha_s}{4\pi}\right) \approx 0.2265,
\end{equation}
matching the experimental value $|V_{us}| = 0.2243 \pm 0.0005$ within $0.98\%$ \cite{pdg2024}.
\end{theorem}

% ==============================================================================
\section{Pillar IV: The Neutrino Sector and Seesaw-Free Mass Scale}
% ==============================================================================

Neutrinos are color and electrically neutral. Their mass operator is generated by the \textbf{Inter-Dimensional Simplicial Trace Operator} $\mathcal{R}_{3 \to 1}^\alpha$ \cite{silvafilho2026book}:

\begin{theorem}[Seesaw-Free Neutrino Mass Scale]\label{thm:neutrino_mass}
The absolute neutrino mass scale is:
\begin{equation}
    m_\nu \sim \frac{v_{\EW}^2}{M_{\GUT}} = \frac{(246.22\text{ GeV})^2}{2.0 \times 10^{15}\text{ GeV}} \approx 0.0303\text{ eV} \approx 30.3\text{ meV}.
\end{equation}
Isotropic wavefunction delocalization on $\Delta_2$ generates large PMNS mixing angles \cite{maki1962remarks,pdg2024}:
\begin{equation}
    \sin^2 \theta_{12} \approx \frac{1}{3} \approx 0.33, \quad \sin^2 \theta_{23} \approx \frac{1}{2} = 0.50, \quad \sin \theta_{13} \approx \frac{\sin \theta_C}{\sqrt{2}} \approx 0.159.
\end{equation}
\end{theorem}

% ==============================================================================
\section{Pillar V: CP Violation and the Jarlskog Invariant}
% ==============================================================================

In the continuous simplicial geometry on $\Delta_2$, the Kobayashi--Maskawa CP-violating phase is generated by the color-shifted orientation $\delta_{\mathrm{CP}} = \frac{\pi}{3} + \sqrt{3}\pi\,\varepsilon_{\mathrm{QCD}} = \frac{\pi}{3} + \frac{\alpha_s(M_Z)}{\sqrt{3}} \approx 1.115\text{ rad} \approx 63.90^\circ$ (matching $\delta_{\mathrm{CP}}^{\mathrm{exp}} = (65.5 \pm 1.5)^\circ$ \cite{pdg2024} within $1.1\sigma$).
The Jarlskog invariant $J_{\mathrm{CP}}$ \cite{jarlskog1985commutator} is, by construction, dimensionless and parametrization-independent:
\begin{equation}
    J_{\mathrm{CP}} = c_{12} c_{23} c_{13}^2 \, s_{12} s_{23} s_{13} \sin\delta_{\mathrm{CP}}.
\end{equation}
Evaluating with the geometric GST Cabibbo angle $s_{12} \equiv \sin\theta_C \approx 0.2265$ and the empirical PDG mixing angles $s_{23} = |V_{cb}| \approx 0.0422$ and $s_{13} = |V_{ub}| \approx 0.00369$ yields:
\begin{equation}
    J_{\mathrm{CP}} \approx 3.08 \times 10^{-5},
\end{equation}
in excellent agreement with the experimental determination $J_{\mathrm{CP}}^{\mathrm{exp}} = (3.08 \pm 0.15) \times 10^{-5}$ \cite{pdg2024}.

% ==============================================================================
\section{Pillar VI: Cosmological Constant Cancellation on Spacetime Simplex \texorpdfstring{$\Delta_4$}{Delta 4}}
% ==============================================================================

\subsection{Simplicial Euler--Maclaurin Defect Cancellation}
In continuous simplicial spacetime $\Delta_4$, the discrete-to-continuum summation of quantum vacuum zero-point fluctuations satisfies the \textbf{Simplicial Euler--Maclaurin Face Defect Recurrence} \cite{silvafilho2026book}:
\begin{equation}
    \rho_{\mathrm{vac}}^{(\Delta_4)} = \sum_{k=0}^4 (-1)^k \binom{5}{k+1} \operatorname{Vol}(\Delta_k) M_P^4 \equiv 0.
\end{equation}

\begin{theorem}[Exact Quartic Divergence Cancellation]\label{thm:cc_cancellation}
By the alternating Euler characteristic $\chi(\Delta_4) = \sum_{k=0}^4 (-1)^k \binom{5}{k+1} = 1$, the leading quartic ($M_P^4$) and quadratic ($M_P^2 m^2$) zero-point energy divergences cancel identically across boundary sub-simplexes:
\begin{equation}
    \sum_{k=0}^4 (-1)^k \binom{4}{k} M_P^4 = (1 - 1)^4 M_P^4 \equiv 0.
\end{equation}
\end{theorem}

