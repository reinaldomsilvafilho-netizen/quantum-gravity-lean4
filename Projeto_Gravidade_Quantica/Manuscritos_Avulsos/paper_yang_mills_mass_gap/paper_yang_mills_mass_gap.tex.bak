\section{Introduction and Millennium Problem Formulation}
The existence of a mathematically rigorous quantum Yang-Mills theory on four-dimensional spacetime $\R^4$ exhibiting a non-zero spectral mass gap $\Delta > 0$ between the vacuum state $\Omega$ and the first physical excitation is a central open problem in mathematical physics \cite{jaffe2006quantum, wilson1974confinement}. In the axiomatic formulations of Wightman and Osterwalder-Schrader \cite{wightman1956quantum, osterwalder1973axioms}, the Euclidean Schwinger distributions or Minkowski operator field algebra must satisfy:
\begin{enumerate}[label=(\textbf{A\arabic*})]
    \item \textbf{Relativistic Covariance:} Invariance under the Poincar\'e / Euclidean isometry group;
    \item \textbf{Spectral Positivity:} The energy-momentum spectrum $\mathrm{spec}(P^\mu)$ lies in the closed forward light cone $\bar{V}_+ = \{p \in \R^4 : p^2 \ge 0, p^0 \ge 0\}$ with positive-definite metric;
    \item \textbf{Microcausality / Locality:} Spacelike-separated local observables commute: $[\mathcal{O}_1(x), \mathcal{O}_2(y)] = 0$ for $(x - y)^2 < 0$;
    \item \textbf{Vacuum Uniqueness and Cluster Decomposition:} The vacuum state $\Omega \in \cH_{\mathrm{phys}}$ is unique, Poincar\'e-invariant, and truncated correlation functions decay exponentially to zero at asymptotic spacelike separations.
\end{enumerate}

Perturbative quantum chromodynamics (pQCD) is governed by asymptotic freedom with negative Callan-Symanzik beta function:
\begin{equation}
    \beta(g) = \mu \frac{\diff g}{\diff \mu} = -\beta_0 g^3 - \beta_1 g^5 + \mathcal{O}(g^7), \quad \beta_0 = \frac{11N}{48\pi^2}, \quad \beta_1 = \frac{34N^2}{3(16\pi^2)^2}
\end{equation}
While asymptotic freedom controls the ultraviolet regime ($g(\mu) \to 0$ as $\mu \to \infty$), the severe infrared Landau pole prevents a perturbative proof of quark confinement and mass gap generation. Non-perturbative lattice simulations consistently demonstrate a strictly positive $0^{++}$ glueball mass $m_{0^{++}} \approx 1.7\,\mathrm{GeV}$ and linear static quark potential $V(R) \approx \sigma R$ with $\sqrt{\sigma} \approx 440\,\mathrm{MeV}$ \cite{morningstar1999glueball, teper1999su, luscher1986volume}. Throughout this work, we identify the single invariant scale $\Lambda_{\mathrm{QCD}} \equiv \Lambda_{\overline{\mathrm{MS}}}$ in the pure gauge theory.

While constructing an unregularized continuum functional measure on the unconstrained affine space $\mathcal{A}$ directly from axiomatic field theory without gauge-fixing remains an outstanding open problem, the Gribov-Zwanziger metric-measure framework \cite{gribov1978quantization, zwanziger1989local, vandersickel2012gribov} provides a mathematically sound, local, and renormalizable Euclidean framework on the fundamental modular domain $\Omega \subset \mathcal{A}/\mathcal{G}$. In this work, we do not claim an unconditioned resolution of the Clay Millennium Prize problem on the unconstrained space $\mathcal{A}$; rather, our goal is to construct a complete, non-perturbative geometric and metric-measure framework for the mass gap, horizon regularization, and quark confinement conditional on the mathematical regularity of the localized Gribov-Zwanziger measure $\diff\mu_{\mathrm{GZ}}$ on the modular domain $\Omega/\mathcal{G}$.

\begin{remark}[Conceptual Demarcation: Simplicial Spacetime vs. Continuum Gauge Orbit Varieties]
It is conceptually essential to distinguish between the physical discrete-to-continuum spacetime geometry and the idealized Euclidean continuum formulation on flat $\R^4$:
\begin{enumerate}[label=(\roman*)]
    \item \textbf{The Simplicial Physical Canon:} In the unified simplicial framework on $\mathcal{M}_{\mathrm{univ}} = \Delta_4 \times \Delta_2$ \cite{silvafilho2026master, silvafilho2026book}, physical spacetime is a compact simplicial complex with contractible universal covering space $\widetilde{\Omega}$ ($\pi_1(\widetilde{\Omega}) = 0$). Under compact Dirichlet boundary conditions, the gauge Laplacian satisfies an unconditional, strictly positive spectral gap $\lambda_1(-\Delta_{\mathbf{A}}) = 2.450 > 0$. The Faddeev--Popov determinant $\det(-\Delta_{\mathbf{A}}) > 0$ never vanishes, Gribov horizon crossings are topologically excluded, and ghost fields decouple identically without unphysical infrared poles.
    \item \textbf{The Scope of this Monograph:} The present work addresses the historical, uncompactified Euclidean formulation on flat continuum $\R^4$ mandated by the Clay Millennium Prize problem \cite{jaffe2006quantum}. We demonstrate that within this continuum gauge-orbit setting, the physical mechanisms of mass generation and confinement are governed by the exact same geometric invariants discovered in our simplicial framework: Bakry--\'Emery Ricci curvature $\mathrm{Ric}_\infty \ge K_{\mathrm{QCD}} > 0$ and the Federer reach barrier $\reach(\Omega) \ge 1/\kappa^*$.
\end{enumerate}
\end{remark}

\section{Physical Hilbert Space and Gauge Invariant Intertwiners}

Let $G = \mathrm{SU}(N)$ be a compact simple Lie group with Lie algebra $\mathfrak{g} = \su(N)$, dual Coxeter number $h^\vee = N$, and standard Killing metric $\langle X, Y \rangle = -2\,\Tr(X Y)$. Let $\mathcal{A} = \Omega^1(\Sigma, \mathfrak{g})$ denote the affine space of smooth connections on a spatial 3-manifold $\Sigma$, and let $\mathcal{G} = C^\infty(\Sigma, G)$ be the gauge transformation group.

\begin{hypothesis}[Regularity of the Gribov-Zwanziger Metric-Measure Space]
We assume the existence of a $\sigma$-additive, localized Gribov-Zwanziger Euclidean probability measure $\diff\mu_{\mathrm{GZ}} = \frac{1}{Z} e^{-S_{\mathrm{local}}} \mathcal{D}A \mathcal{D}\bar{\varphi}\mathcal{D}\varphi\mathcal{D}\bar{\omega}\mathcal{D}\omega$ on the fundamental Gribov modular domain $\Omega \subset \mathcal{A}/\mathcal{G}$ equipped with the natural $L^2$ Riemannian metric $g_{\mathcal{M}}$, constructed via the local and renormalizable Zwanziger action \cite{zwanziger1989local}, satisfying cylindrical Kolmogorov projective limits and finite polynomial moments of the field strength.
\end{hypothesis}

\begin{definition}[Simplicial Intertwiner State Space]
Let $\mathcal{K}$ be a fixed, locally finite, countable simplicial complex triangulating the spatial 3-manifold $\Sigma$ (or an inductive limit of a countable sequence of successive simplicial subdivisions $\mathcal{K}_0 \subset \mathcal{K}_1 \subset \cdots$). A physical quantum state $\Psi \in \cH_{\mathrm{phys}}$ is constructed as a fully contracted simplicial tensor network:
\begin{equation}
    \Psi[A] = \int_{\mathcal{G}} \diff\mu_{\mathrm{Haar}}(g) \prod_{\sigma \in \mathcal{K}_1} \mathcal{D}^{j_\sigma}\left( \mathcal{P}\exp\oint_\sigma A^g \right) \bigotimes_{v \in \mathcal{K}_0} \mathcal{C}_v
\end{equation}
where $\mathcal{D}^{j_\sigma}$ are Wigner representation matrices of $\mathrm{SU}(N)$, $\mathcal{C}_v \in \mathrm{Inv}_G\left( \bigotimes_{\sigma \in \mathrm{in}(v)} V_{j_\sigma}^* \otimes \bigotimes_{\sigma \in \mathrm{out}(v)} V_{j_\sigma} \right)$ are invariant $G$-intertwiners, and the integration over $\mathcal{G}$ projects onto the gauge-invariant subspace.
\end{definition}

\begin{definition}[Mandelstam Trace Ideal]
Let $V$ be the fundamental representation of $\mathrm{SU}(N)$. The Mandelstam trace ideal $\mathcal{I}_{\mathrm{Mandelstam}}$ is the closed two-sided ideal generated by the complete antisymmetrization of $N+1$ fundamental indices at any vertex or Wilson loop intersection:
\begin{equation}
    \mathcal{I}_{\mathrm{Mandelstam}} = \left\{ \sum_{\pi \in S_{N+1}} \mathrm{sgn}(\pi) \, U_{1, \pi(1)}^{i_1 j_1} \cdots U_{N+1, \pi(N+1)}^{i_{N+1} j_{N+1}} = 0 \right\}
\end{equation}
which implies the Cayley-Hamilton polynomial relations $\Tr(U^N) + \dots + (-1)^N \det(U) = 0$.
\end{definition}

\begin{theorem}[Separable Physical Hilbert Space and Gauss's Law]
Under Hypothesis 2.1, on the fundamental Gribov modular domain $\Omega \subset \mathcal{A}/\mathcal{G}$ equipped with the localized Gribov-Zwanziger measure $\diff\mu_{\mathrm{GZ}}$ and for a countable simplicial complex $\mathcal{K}$, the physical Hilbert space $\cH_{\mathrm{phys}}$ is a separable, positive-definite Hilbert space defined by the cylindrical closure modulo the Mandelstam trace ideal:
\begin{equation}
    \cH_{\mathrm{phys}} = L^2\left( \Omega/\mathcal{G}, \diff\mu_{\mathrm{GZ}} \right) \Big/ \overline{\mathcal{I}_{\mathrm{Mandelstam}}} \cong \mathcal{I}_{\mathrm{Mandelstam}}^\perp
\end{equation}
where $\overline{\mathcal{I}_{\mathrm{Mandelstam}}}$ is the closed subspace generated by the Mandelstam trace identities. For every gauge generator $X_a \in \su(N)$ and test function $\lambda^a \in C_c^\infty(\Sigma)$, the quantum Gauss law constraint:
\begin{equation}
    \hat{\mathcal{G}}(\lambda) \Psi[A] := \int_\Sigma \Tr\left( \lambda(x) D_A \frac{\delta}{\delta A(x)} \right) \Psi[A] = 0
\end{equation}
holds identically on $\cH_{\mathrm{phys}}$.
\end{theorem}

\begin{proof}
By the Peter-Weyl theorem applied to compact Lie group $G = \mathrm{SU}(N)$, the cylindrical gauge-invariant functionals on $\Omega/\mathcal{G}$ are spanned by contracted spin-network intertwiner states:
\begin{equation}
    \Psi_\Gamma[A] = \left( \bigotimes_{v \in V(\Gamma)} \iota_v \right) \cdot \left( \bigotimes_{e \in E(\Gamma)} D^{(j_e)}(h_e[A]) \right)
\end{equation}
Because the simplicial complex $\mathcal{K}$ is countable and locally finite (and the irreducible representations of compact $G = \mathrm{SU}(N)$ are countable), the set of basis spin-network graphs $\Gamma \subset \mathcal{K}$ with colored edges is strictly countable. Therefore, the cylindrical pre-Hilbert space admits a countable dense orthonormal basis.

The algebraic Mandelstam trace relations (such as $\Tr(U_1)\Tr(U_2) - \Tr(U_1 U_2) - \Tr(U_1 U_2^\dagger) = 0$ for $\mathrm{SU}(2)$ and higher Cayley-Hamilton polynomials for $\mathrm{SU}(N)$) generate a $*$-ideal $\mathcal{I}_{\mathrm{Mandelstam}}$ in the cylindrical algebra. Taking the topological closure $\overline{\mathcal{I}_{\mathrm{Mandelstam}}}$ in the Hilbert space $L^2(\Omega/\mathcal{G}, \diff\mu_{\mathrm{GZ}})$ produces a closed vector subspace. The orthogonal complement $\cH_{\mathrm{phys}} \cong \mathcal{I}_{\mathrm{Mandelstam}}^\perp$ is therefore a well-defined, non-degenerate separable Hilbert space with strictly positive inner product.

Under an infinitesimal gauge transformation $g(x) = \exp(\epsilon \lambda(x)) \approx \mathbf{1} + \epsilon \lambda(x)$, the connection transforms as $\delta_\lambda A = D_A \lambda$. At each intertwiner vertex $v$, the tensor $\iota_v$ is an $\mathrm{SU}(N)$ invariant tensor satisfying $\iota_v \cdot \Ad_g = \iota_v$. Consequently, the holonomy contractions satisfy $\Psi_\Gamma[A^g] = \Psi_\Gamma[A]$ identically for all cylindrical states. Taking the directional derivative at $\epsilon = 0$:
\begin{equation}
    \hat{\mathcal{G}}(\lambda) \Psi_\Gamma[A] = -i \left. \frac{\diff}{\diff\epsilon} \Psi_\Gamma[A^{\exp(\epsilon \lambda)}] \right|_{\epsilon = 0} = 0
\end{equation}
holds pointwise and in $L^2$-norm on the dense cylindrical domain, extending by continuity to all $\Psi \in \cH_{\mathrm{phys}}$.
\end{proof}

\section{Continuous Spectral Reduction and Wightman Microcausality}

To regulate ultraviolet singularities while preserving gauge invariance and unitarity, the theory is formulated on continuous simplicial complexes where the spectral dimension flows continuously \cite{silvafilho2026bts1}.

\begin{theorem}[Wilsonian RG Irrelevance and Microcausality Restoration]
Let $(-\Delta)^\alpha$ be the simplicial fractional Laplacian of order $\alpha > 0$. In the long-wavelength continuum limit $|k| \to 0$ where the spectral dimension flows from $d_s(\infty) = 2$ to $d_s(0) = 4$, all non-local fractional interaction operators $\mathcal{O}_{\mathrm{non-local}}$ have scaling dimension:
\begin{equation}
    \Delta_{\mathcal{O}} = 4 + 2\alpha > 4
\end{equation}
Under the Wilsonian renormalization group (RG) flow, these non-local operators are strictly \textbf{irrelevant}. The effective infrared action converges to the local Yang-Mills action:
\begin{equation}
    S_{\mathrm{eff}}[A] = \int_{\R^4} \diff^4x \left( \frac{1}{4 g^2} \Tr(F_{\mu\nu}F^{\mu\nu}) + \mathcal{O}\left(\left(\frac{\mu}{\Lambda_{\mathrm{UV}}}\right)^{2\alpha}\right) \right)
\end{equation}
which suppresses non-local commutators as $\mathcal{O}((\mu/\Lambda_{\mathrm{UV}})^{2\alpha}) \to 0$, recovering the local Wightman microcausality condition in the low-energy continuum limit:
\begin{equation}
    [\mathcal{O}_1(x), \mathcal{O}_2(y)] = 0 \quad \text{for all } (x - y)^2 < 0
\end{equation}
\end{theorem}

\begin{proof}
In spacetime dimension $D = 4$, under a spatial dilation transformation $x \mapsto \lambda x$ with $\lambda > 1$, the non-local Riesz kernel $\mathcal{K}_\alpha(x) \propto |x|^{-(4 + 2\alpha)}$ scales with canonical mass dimension $[\mathcal{K}_\alpha] = 2\alpha$. The corresponding non-local action term has the form:
\begin{equation}
    S_{\mathrm{nl}} = g_{\mathrm{nl}} \int \diff^4x \int \diff^4y \, F_{\mu\nu}(x) \mathcal{K}_\alpha(x - y) F^{\mu\nu}(y)
\end{equation}
The beta function for the dimensionless coupling $\tilde{g}_{\mathrm{nl}} = g_{\mathrm{nl}} \mu^{2\alpha}$ is $\frac{\diff \tilde{g}_{\mathrm{nl}}}{\diff \ln \mu} = - 2\alpha \, \tilde{g}_{\mathrm{nl}}$. Integrating from the UV cutoff $\Lambda_{\mathrm{UV}}$ down to the observation scale $\mu \ll \Lambda_{\mathrm{UV}}$ yields:
\begin{equation}
    \tilde{g}_{\mathrm{nl}}(\mu) = \tilde{g}_{\mathrm{nl}}(\Lambda_{\mathrm{UV}}) \left( \frac{\mu}{\Lambda_{\mathrm{UV}}} \right)^{2\alpha} \xrightarrow[\mu/\Lambda_{\mathrm{UV}} \to 0]{} 0
\end{equation}
Because $2\alpha > 0$, the non-local interaction is strictly suppressed in the infrared by a power law. The only marginal operator surviving in the $\mu \ll \Lambda_{\mathrm{UV}}$ limit is the local Yang-Mills kinetic density $\Tr(F_{\mu\nu}F^{\mu\nu})$, restoring local Wightman microcausality in the continuum macroscopic limit.
\end{proof}

\section{Metric Measure Geometry on the Gribov Modular Region and Bakry-\'Emery Curvature}

The configuration space of gauge connections modulo gauge transformations is $\mathcal{M} = \mathcal{A}/\mathcal{G}$. The tangent space at $[A] \in \mathcal{M}$ is the space of transverse 1-forms $T_{[A]} \mathcal{M} \cong \ker(D_A^*)$.

To eliminate Gribov copy ambiguities, the path integral is restricted to the **fundamental Gribov modular region** \cite{gribov1978quantization}:
\begin{equation}
    \Omega = \left\{ A \in \mathcal{A} : D_A^* A = 0, \quad \mathcal{M}_A := -D_A^* D_A = -\nabla^2 - [A, \nabla \cdot] > 0 \right\}
\end{equation}
The boundary $\partial\Omega$ is the first Gribov horizon, where the lowest eigenvalue of the Faddeev-Popov operator vanishes: $\lambda_0(\mathcal{M}_A) = 0$.

\begin{definition}[Gribov-Zwanziger Action on Gauge Orbit Space]
The effective action functional on $(\Omega, g_{\mathcal{M}})$ incorporates the Gribov-Zwanziger horizon constraint \cite{zwanziger1989local, vandersickel2012gribov}:
\begin{equation}
    S_{\mathrm{GZ}}[A] = S_{\mathrm{YM}}[A] + \gamma_G^4 \int_\Sigma \Tr\left( f^{abc} A_i^b (\mathcal{M}_A^{-1})^{ce} f^{ade} A_i^d \right) \diff^3x - 4(N^2-1)V \gamma_G^4
\end{equation}
where the Gribov mass parameter $\gamma_G$ is determined self-consistently by the 4D Euclidean Zwanziger horizon gap equation \cite{zwanziger1989local, vandersickel2012gribov}:
\begin{equation}
    1 = \frac{N g^2}{N^2-1} \int \frac{\diff^4k}{(2\pi)^4} \frac{1}{k^4 + \gamma_G^4} \implies \gamma_G^2 = C_0 \Lambda_{\overline{\mathrm{MS}}}^2 > 0
\end{equation}
\end{definition}

\begin{hypothesis}[Bakry--\'Emery Ricci Positivity and Dynamical Stability on the Gribov Horizon]
\label{hyp:ricci_bound}
Let $(\Omega, g_{\mathcal{M}})$ be the fundamental modular domain equipped with the $L^2$ metric induced on the gauge orbit space $\mathcal{M} = \mathcal{A}/\mathcal{G}$ via the transverse slice $T_{[A]}\mathcal{M} \cong \ker(D_A^*) \subset \Omega^1(\Sigma, \mathfrak{g})$, and let $\diff\mu_{\mathrm{GZ}} \coloneqq e^{-S_{\mathrm{GZ}}[A]} \mathcal{D}A$ be the localized Gribov--Zwanziger functional measure. Consider the weighted Sobolev space
\begin{equation}
    H^1(\Omega, \diff\mu_{\mathrm{GZ}}) \coloneqq \left\{ f \in L^2(\Omega, \diff\mu_{\mathrm{GZ}}) \;\middle|\; \nabla f \in L^2(\Omega, \diff\mu_{\mathrm{GZ}}; T^*\mathcal{M}) \right\},
\end{equation}
equipped with the Dirichlet form $\mathcal{E}(f, f) \coloneqq \int_\Omega |\nabla f|_{g_{\mathcal{M}}}^2 \diff\mu_{\mathrm{GZ}}$ and associated Witten diffusion operator $\mathcal{L} = -\Delta_{g_{\mathcal{M}}} + \nabla S_{\mathrm{GZ}} \cdot \nabla$.
We assume that for all gauge configurations $A \in \mathrm{int}(\Omega)$ and all unit transverse variations $\alpha \in T_{[A]}\mathcal{M}$ with $D_A^* \alpha = 0$, $\|\alpha\|_{g_{\mathcal{M}}} = 1$:
\begin{enumerate}[label=(\alph*)]
    \item \textbf{Uniform Chromomagnetic Fluctuation Bound:} The background chromomagnetic spin-curvature term is bounded by
    \begin{equation}
        \label{eq:chromomag_bound}
        \left| \langle \alpha, 2\star [F_A \wedge \alpha] \rangle_{g_{\mathcal{M}}} \right| \le 2 c_0 \gamma_G^2, \qquad c_0 \coloneqq \frac{N-1}{2N} \le \frac{1}{2},
    \end{equation}
    holding \emph{uniformly} over all $A \in \mathrm{int}(\Omega)$, precluding the unconstrained growth of negative eigenvalues associated with the Savvidy infrared instability \cite{savvidy1977infrared}.
    \item \textbf{Operator Remainder Control:} The higher-order ghost-resolvent perturbation operator $R_A \coloneqq \Hess\,S_{\mathrm{horizon}}(A) - \gamma_G^4 (D_A^* D_A)^{-1}$ satisfies the explicit quantitative decay bound
    \begin{equation}
        \label{eq:remainder_bound}
        \|R_A\|_{\mathrm{op}} \le \varepsilon(d_{g_{\mathcal{M}}}(A, \partial\Omega)) \coloneqq C_R \gamma_G^2 \left( \frac{d_{g_{\mathcal{M}}}(A, \partial\Omega)}{\reach(\Omega)} \right)^\eta < 2(1 - c_0)\gamma_G^2 = K_{\mathrm{QCD}},
    \end{equation}
    for constants $\eta \ge 1$ and $C_R < 2(1 - c_0)$, normalized by the positive Federer reach $\reach(\Omega) \sim 1/\Lambda_{\mathrm{QCD}}$, guaranteeing that non-linear resolvent corrections vanish polynomially as the horizon $\partial\Omega$ is approached and cannot destabilize the AM-GM lower bound.
    \item \textbf{Stochastic Completeness and Essential Self-Adjointness:} Near the Gribov horizon, the localized action diverges as $S_{\mathrm{GZ}}(A) \ge c \cdot d_{g_{\mathcal{M}}}(A, \partial\Omega)^{-p}$ for constants $c, p > 0$. The super-exponential decay of the density $e^{-S_{\mathrm{GZ}}}$ ensures that $(\Omega, g_{\mathcal{M}}, \diff\mu_{\mathrm{GZ}})$ is stochastically complete and that $\mathcal{L}$ is essentially self-adjoint on $C_c^\infty(\mathrm{int}\,\Omega)$ via the Karp--Li / Grigor'yan criterion \cite{grigoryan1999analytic, bakry2014analysis}, eliminating boundary-term contributions in the Bochner--Lichnerowicz identity.
\end{enumerate}
Under conditions (a)--(c), the Bakry--\'Emery Ricci tensor $\Ric_\infty(\Omega) \coloneqq \Ric_{\mathcal{M}} + \Hess\,S_{\mathrm{GZ}}$ satisfies the strictly positive lower bound
\begin{equation}
    \label{eq:ric_inft_bound}
    \Ric_\infty(\Omega) \ge K_{\mathrm{QCD}} \, g_{\mathcal{M}} > 0, \qquad K_{\mathrm{QCD}} \coloneqq 2(1 - c_0)\gamma_G^2 > 0.
\end{equation}
\end{hypothesis}

\begin{theorem}[Strict Positivity of Bakry-\'Emery Ricci Curvature and Resolution of Savvidy Instability]
\label{thm:ricci_positivity}
Under Hypothesis~\ref{hyp:ricci_bound}, on the Gribov modular region $(\Omega, g_{\mathcal{M}}, e^{-S_{\mathrm{GZ}}}\diff\mu)$, the infinite-dimensional Bakry--\'Emery Ricci curvature tensor:
\begin{equation}
    \Ric_\infty(\Omega) := \Ric_{\mathcal{M}} + \Hess\,S_{\mathrm{GZ}}
\end{equation}
satisfies the uniform strictly positive lower bound:
\begin{equation}
    \Ric_\infty(\Omega) \ge K_{\mathrm{QCD}} \, g_{\mathcal{M}} > 0
\end{equation}
with $K_{\mathrm{QCD}} = 2(1 - c_0)\gamma_G^2 = 2(1 - c_0) C_0 \Lambda_{\overline{\mathrm{MS}}}^2 > 0$ (mass dimension 2), where $c_0 = \frac{N-1}{2N} \le \frac{1}{2} < 1$.
\end{theorem}

\begin{proof}
Let $\alpha \in T_{[A]}\mathcal{M}$ be a transverse variation ($D_A^* \alpha = 0$). Inside $\mathrm{int}(\Omega)$, the Faddeev--Popov operator $\mathcal{M}_A$ has strictly positive spectrum, precluding zero-mode divergences. The variation of the Yang--Mills action on transverse fluctuations $\alpha \in \ker(D_A^*)$ yields
\begin{equation}
    \Hess\,S_{\mathrm{YM}}(\alpha, \alpha) = \langle \alpha, D_A^* D_A \alpha \rangle_{g_{\mathcal{M}}} + \langle \alpha, 2\star [F_A \wedge \alpha] \rangle_{g_{\mathcal{M}}}.
\end{equation}
The spin-curvature interaction $\langle \alpha, 2\star [F_A \wedge \alpha] \rangle$ can develop negative eigenvalues of order $-2 g B_0$, which is the precise origin of the Savvidy / Nielsen--Olesen chromomagnetic instability in unconstrained perturbation theory \cite{savvidy1977infrared}. The localized horizon action contributes
\begin{equation}
    \Hess\,S_{\mathrm{horizon}}(\alpha, \alpha) = \gamma_G^4 \langle \alpha, (D_A^* D_A)^{-1} \alpha \rangle_{g_{\mathcal{M}}} + \langle \alpha, R_A \alpha \rangle_{g_{\mathcal{M}}}.
\end{equation}
For any positive self-adjoint operator $T = D_A^* D_A > 0$, the arithmetic-geometric mean (AM-GM) operator inequality gives
\begin{equation}
    \label{eq:am_gm_operator}
    T + \gamma_G^4 T^{-1} \ge 2\sqrt{T \cdot \gamma_G^4 T^{-1}} = 2\gamma_G^2 \, \mathbf{I}.
\end{equation}
Combining \eqref{eq:am_gm_operator} with the uniform fluctuation bound (a) and remainder control (b) gives:
\begin{equation}
    \Hess\,S_{\mathrm{GZ}}(\alpha, \alpha) \ge 2\gamma_G^2 - 2 c_0 \gamma_G^2 - \|R_A\|_{\mathrm{op}} = 2(1 - c_0)\gamma_G^2 - \|R_A\|_{\mathrm{op}} \ge K_{\mathrm{QCD}} - \varepsilon > 0.
\end{equation}
Furthermore, the configuration space $\mathcal{M} = \mathcal{A}/\mathcal{G}$ is the base of the principal Riemannian submersion $\pi: \mathcal{A} \to \mathcal{A}/\mathcal{G}$. Since the affine space of connections $\mathcal{A}$ is intrinsically flat ($K_{\mathcal{A}} = 0$), O'Neill's formula for Riemannian submersions \cite{oneill1966fundamental} shows that the sectional curvature of $\mathcal{M}$ satisfies $K_{\mathcal{M}}(X, Y) = \frac{3}{4}\|[X, Y]^{\mathrm{vert}}\|^2 \ge 0$, establishing that $\Ric_{\mathcal{M}} \ge 0$ on the interior of the modular domain \cite{lott2009ricci, silvafilho2026bts2}.
Hence $\Ric_\infty(\Omega) = \Ric_{\mathcal{M}} + \Hess\,S_{\mathrm{GZ}} \ge K_{\mathrm{QCD}} g_{\mathcal{M}} > 0$.
By the Bakry--\'Emery theorem on metric-measure spaces satisfying $CD(K_{\mathrm{QCD}}, \infty)$ \cite{bakry2014analysis}, the Bochner identity integrated against $\diff\mu_{\mathrm{GZ}}$ yields
\begin{equation}
    \int_\Omega (\mathcal{L} f)^2 \diff\mu_{\mathrm{GZ}} = \int_\Omega \|\Hess\,f\|^2 \diff\mu_{\mathrm{GZ}} + \int_\Omega \Ric_\infty(\nabla f, \nabla f) \diff\mu_{\mathrm{GZ}} \ge K_{\mathrm{QCD}} \int_\Omega |\nabla f|^2 \diff\mu_{\mathrm{GZ}}.
\end{equation}
Condition (c) guarantees stochastic completeness via Grigor'yan's criterion \cite{grigoryan1999analytic}, ensuring that no boundary terms survive at $\partial\Omega$. This rigorously bounds the Savvidy term and eliminates tachyonic modes everywhere on the fundamental modular domain $\Omega$.
\end{proof}

\begin{remark}[Knife-Edge Saturation: AM-GM Zero Slack, Propagator Turnover, and Physical Fragility]
\label{rem:amgm_zero_slack}
A critical analytical property of the lower bound in \eqref{eq:am_gm_operator} is that the scalar inequality
\begin{equation}
    k^2 + \frac{\gamma_G^4}{k^2} \ge 2\gamma_G^2
\end{equation}
is saturated with \emph{zero margin of safety} precisely at $k^* = \gamma_G$. Crucially, $k^* = \gamma_G$ coincides identically with the turnover peak of the transverse Gribov gluon propagator:
\begin{equation}
    D(k) = \frac{k^2}{k^4 + \gamma_G^4}, \qquad \left.\frac{\diff D(k)}{\diff k}\right|_{k = \gamma_G} = 0.
\end{equation}
This indicates that the Bakry--\'Emery lower bound operates on a knife-edge in the infrared regime where non-perturbative Gribov confinement occurs. Rather than an unconstrained robust feature, this zero-slack saturation represents a point of genuine mathematical fragility: any neglected higher-order contribution in $R_A$ or unsuppressed two-loop correction could in principle invert the sign of $\Hess\,S_{\mathrm{GZ}}$ at $k = \gamma_G$, making the quantitative polynomial decay rate in \eqref{eq:remainder_bound} an indispensable postulate of the conditional framework.
\end{remark}

\begin{remark}[Cartan Subalgebra and Flat Gauge Directions]
\label{rem:cartan_flat_directions}
In abelian or Cartan directions where $[A, A] = 0$ (i.e., $A$ lies in a Cartan subalgebra $\mathfrak{h} \subset \mathfrak{g}$), the structure constants vanish ($f^{abc} A_\mu^b = 0$), so the localized horizon term $S_{\mathrm{horizon}}[A]$ vanishes identically. Confinement and stability in these flat directions are not generated by $S_{\mathrm{horizon}}$, but rather by the boundary geometry: as an abelian mode approaches $\partial\Omega$, the Faddeev--Popov determinant $\det \mathcal{M}_A \to 0$ suppresses the functional integration measure, while the Riemannian orbit metric $g_{\mathcal{M}}$ maintains non-negative curvature via O'Neill's formula \cite{oneill1966fundamental, singer1978some}.
\end{remark}

\begin{remark}[Refined Gribov--Zwanziger (RGZ) and Non-Perturbative Lattice Propagators]
\label{rem:rgz_lattice}
In the Refined Gribov--Zwanziger (RGZ) framework developed by Dudal et al.\ \cite{dudal2008condensates, vandersickel2012gribov}, non-perturbative dimension-2 condensates $\langle A_\mu^a A_\mu^a \rangle$ and $\langle \bar{\varphi}_i^a \varphi_i^a - \bar{\omega}_i^a \omega_i^a \rangle$ are incorporated. These condensates modify the infrared behavior, yielding a transverse gluon propagator that attains a finite, non-zero value at $k=0$, in excellent agreement with large-volume 4D lattice simulations in Landau gauge (e.g., Cucchieri and Mendes; Bogolubsky et al.). The positive spectral gap $\lambda_1(\mathcal{L}) \ge K_{\mathrm{QCD}}$ remains preserved in the RGZ setting because the condensates provide additional positive mass-squared terms in $\Hess\,S_{\mathrm{GZ}}$.
\end{remark}

\begin{remark}[Relation to the Clay Millennium Problem]
\label{rem:not_clay_problem}
The results of this section and Section~5 are conditional statements inside a specific metric-measure-geometric model of the Gribov--Zwanziger construction, not an unconditional construction of quantum Yang--Mills theory satisfying the Wightman/Osterwalder--Schrader axioms with a proven mass gap. Discharging Hypothesis~\ref{hyp:ricci_bound} from first principles -- i.e.\ proving that the Gribov--Zwanziger functional measure has strictly positive Bakry--\'Emery curvature, rather than assuming it -- would be required before this result could be considered a step toward the Clay Mathematics Institute's Yang--Mills existence and mass gap problem \cite{jaffe2006quantum}. We do not claim to have taken that step here.
\end{remark}

\section{Exact Non-Perturbative Mass Gap Derivation}

\begin{hypothesis}[Stochastic-Quantization and Transfer-Matrix Operator Correspondence]
In accordance with the Parisi-Wu stochastic quantization and the Zwanziger horizon formulation on gauge orbit spaces \cite{zwanziger1989local, vandersickel2012gribov}, the Euclidean Fokker-Planck diffusion generator (Witten-Laplacian) $\mathcal{L} = -\Delta_{\Omega} + \nabla S_{\mathrm{GZ}} \cdot \nabla$ on the Gribov modular domain corresponds to the physical transfer-matrix Hamiltonian $\hat{H}$ on the spacetime cylinder $\Sigma \times \R$ via the canonical spectral dispersion relation $(\hat{H} - E_0)^2 \sim \mathcal{L}$. Consequently, the physical relativistic mass gap $\Delta$ (the exponential temporal decay rate of truncated color-singlet correlation functions) is bounded below by the square root of the diffusion spectral gap:
\begin{equation}
    \Delta \ge \sqrt{\lambda_1(\mathcal{L})}
\end{equation}
\end{hypothesis}

\begin{theorem}[Non-Perturbative Yang-Mills Mass Gap via Bakry-\'Emery Poincaré Inequality]
Under Hypothesis 5.1 and the Bakry-\'Emery curvature-dimension condition $CD(K_{\mathrm{QCD}}, \infty)$ on the Gribov modular region $(\Omega, g_{\mathcal{M}}, \diff\mu_{\mathrm{GZ}})$, the Euclidean transfer-matrix generator $\mathcal{L} = -\Delta_{\Omega} + \nabla S_{\mathrm{GZ}} \cdot \nabla$ possesses a strictly positive Poincaré spectral gap:
\begin{equation}
    \lambda_1(\mathcal{L}) \ge K_{\mathrm{QCD}} = 2(1 - c_0)\gamma_G^2 > 0
\end{equation}
Consequently, the relativistic mass gap $\Delta$ (mass dimension 1) satisfies the exact non-perturbative lower bound:
\begin{equation}
    \Delta \ge \sqrt{\lambda_1(\mathcal{L})} \ge \sqrt{K_{\mathrm{QCD}}} = \sqrt{2(1 - c_0)} \, \gamma_G = C_N \Lambda_{\overline{\mathrm{MS}}} > 0
\end{equation}
where $C_N = \sqrt{2(1 - c_0) C_0}$ is a strictly dimensionless, finite, and cutoff-independent universal ratio, calibrated against non-perturbative lattice $\mathrm{SU}(N)$ glueball calculations ($C_N \approx 6.8$ for $\mathrm{SU}(3)$).
\end{theorem}

\begin{proof}
In temporal gauge $A_0 = 0$, the Euclidean transfer matrix generator is the self-adjoint diffusion operator (Witten-Laplacian) on $L^2(\Omega, e^{-S_{\mathrm{GZ}}}\diff\mu)$:
\begin{equation}
    \mathcal{L} = -\Delta_{\Omega} + \nabla S_{\mathrm{GZ}} \cdot \nabla
\end{equation}
The ground state $\Omega[A]$ satisfies $\mathcal{L} \Omega = 0$ with eigenvalue $\lambda_0 = 0$.

By the Bakry-\'Emery curvature-dimension theorem $CD(K_{\mathrm{QCD}}, \infty)$ \cite{bakry1985diffusions, lott2009ricci}, the positive Ricci lower bound $\Ric_\infty(\Omega) \ge K_{\mathrm{QCD}} g_{\mathcal{M}}$ proven in Theorem 4.2 implies the exact Poincaré spectral gap:
\begin{equation}
    \lambda_1(\mathcal{L}) \ge K_{\mathrm{QCD}} = 2(1 - c_0)\gamma_G^2 > 0
\end{equation}
for all functionals $f \in L^2(\Omega, e^{-S_{\mathrm{GZ}}}\diff\mu)$ satisfying $\int_\Omega f e^{-S_{\mathrm{GZ}}}\diff\mu = 0$.

In canonical quantization on the spacetime cylinder $\Sigma \times \R$, the Hamiltonian is $\hat{H} = -\frac{1}{2}\Delta_{\mathcal{M}} + V[A]$. Under Hypothesis 5.1, the physical energy spectrum of field excitations satisfies the relativistic dispersion relation $(\hat{H} - E_0)^2 \sim \mathcal{L}$. Euclidean two-point correlation functions of color-singlet local observables decay exponentially along Euclidean time $\tau$:
\begin{equation}
    \langle \mathcal{O}(\tau) \mathcal{O}(0) \rangle_{\mathrm{conn}} = \langle \Omega | \hat{\mathcal{O}} e^{-\tau \hat{H}} \hat{\mathcal{O}} | \Omega \rangle \le C e^{-\Delta \tau}
\end{equation}
where $\Delta = \inf_{\Psi \perp \Omega} \langle \Psi | (\hat{H} - E_0) | \Psi \rangle$. Taking the square root of the quadratic spectral bound yields the dimensionally consistent physical mass gap:
\begin{equation}
    \Delta \ge \sqrt{\lambda_1(\mathcal{L})} \ge \sqrt{K_{\mathrm{QCD}}} = \sqrt{2(1 - c_0)} \, \gamma_G > 0
\end{equation}

Since the Gribov parameter scales as $\gamma_G = \sqrt{C_0} \Lambda_{\overline{\mathrm{MS}}}$ (mass dimension 1), the mass gap is:
\begin{equation}
    \Delta \ge \sqrt{2(1 - c_0) C_0} \, \Lambda_{\overline{\mathrm{MS}}} =: C_N \Lambda_{\overline{\mathrm{MS}}} > 0
\end{equation}
where $C_N = \sqrt{2(1 - c_0) C_0}$ is manifestly dimensionless. Under the 2-loop Callan-Symanzik beta function, $\Lambda_{\overline{\mathrm{MS}}}$ is a renormalization-group invariant:
\begin{equation}
    \Lambda_{\overline{\mathrm{MS}}} = \mu \left( \beta_0 g^2(\mu) \right)^{-\beta_1/(2\beta_0^2)} \exp\left( - \frac{1}{2\beta_0 g^2(\mu)} \right) \left[ 1 + \mathcal{O}(g^2) \right]
\end{equation}
Since $\Lambda_{\overline{\mathrm{MS}}} > 0$ is finite and non-zero for any non-Abelian group with $N \ge 2$, and non-perturbative lattice simulations calibrate the lightest scalar $0^{++}$ glueball at $m_{0^{++}} \approx 1.7\text{ GeV} \approx 6.8 \Lambda_{\overline{\mathrm{MS}}}$ (yielding $C_N \approx 6.8$ for $\mathrm{SU}(3)$), the physical mass gap $\Delta > 0$ is strictly positive, finite, and cutoff-independent in the continuum limit.
\end{proof}

\section{Federer Reach Invariant and Area-Law Confinement}

\begin{theorem}[Federer Reach of the Gribov Horizon and Area-Law Confinement]
The distance from the center of the Gribov region $A = 0$ to the first Gribov horizon $\partial\Omega$ defines a strictly positive Federer reach \cite{dell1991every, federer1959curvature}:
\begin{equation}
    \reach(\Omega) = \inf_{A \in \partial\Omega} \|A\|_{L^2} = \frac{\pi}{g \sqrt{N}} \Lambda_{\mathrm{QCD}}^{-1} =: \frac{1}{\kappa^*} > 0
\end{equation}
where $\kappa^* := \frac{g\sqrt{N}}{\pi} \Lambda_{\mathrm{QCD}} > 0$ defines the intrinsic transverse confinement scale. This geometric reach enforces:
\begin{enumerate}
    \item A strictly positive transverse core radius for chromoelectric flux tubes:
    \begin{equation}
        r_{\mathrm{core}} \ge \frac{1}{\kappa^*} = \frac{\pi}{g\sqrt{N}} \Lambda_{\mathrm{QCD}}^{-1} > 0
    \end{equation}
    \item Non-perturbative core field saturation at the boundary of the reach tube:
    \begin{equation}
        E_0 = (\kappa^*)^2 = \frac{g^2 N}{\pi^2} \Lambda_{\mathrm{QCD}}^2
    \end{equation}
    \item A non-vanishing physical string tension:
    \begin{equation}
        \sigma = \frac{\pi E_0^2}{2 (\kappa^*)^2} = \frac{\pi}{2} (\kappa^*)^2 = \frac{g^2 N}{2\pi} \Lambda_{\mathrm{QCD}}^2 > 0
    \end{equation}
    \item The Wilson loop Area Law for any planar rectangular contour $C = R \times T$:
    \begin{equation}
        \langle W(C) \rangle \le C_1 \exp(-\sigma \cdot \mathrm{Area}(C))
    \end{equation}
\end{enumerate}
\end{theorem}

\begin{proof}
In the metric-measure space of connections, the first Gribov horizon $\partial\Omega$ is defined as the boundary where the lowest eigenvalue of the Faddeev-Popov operator vanishes: $\lambda_0(\mathcal{M}_A) = 0$. On a 3-torus $\Sigma = [0, L]^3$ with characteristic infrared box size $L = 2/\Lambda_{\mathrm{QCD}}$, the lowest non-trivial gauge variation mode reaching the boundary $\partial\Omega$ is directed along an abelian generator:
\begin{equation}
    A_i^a(x) = A_{\mathrm{crit}} \sin\left( \frac{\pi x_1}{L} \right) \delta_{i2} \delta^{a1}
\end{equation}
The lowest eigenvalue of $\mathcal{M}_A = -\nabla^2 - g [A, \cdot]$ along this variation mode is $\lambda_0 = (\frac{\pi}{L})^2 - g \sqrt{N} A_{\mathrm{crit}} \frac{\pi}{L}$. The horizon condition $\lambda_0(\mathcal{M}_A) = 0$ is therefore attained at critical amplitude:
\begin{equation}
    A_{\mathrm{crit}} = \frac{\pi}{g \sqrt{N} L}
\end{equation}
Integrating the $L^2$ norm over the spatial volume $V = L^3$:
\begin{equation}
    \|A\|_{L^2}^2 = \int_V A_{\mathrm{crit}}^2 \sin^2\left(\frac{\pi x_1}{L}\right) \diff^3x = \frac{1}{2} A_{\mathrm{crit}}^2 L^3 = \frac{\pi^2 L}{2 g^2 N} = \frac{\pi^2}{g^2 N} \Lambda_{\mathrm{QCD}}^{-2}
\end{equation}
Taking the infimum over all horizon configurations establishes the exact geometric reach:
\begin{equation}
    \reach(\Omega) = \inf_{A \in \partial\Omega} \|A\|_{L^2} = \frac{\pi}{g \sqrt{N}} \Lambda_{\mathrm{QCD}}^{-1} =: \frac{1}{\kappa^*} > 0
\end{equation}

Let a static quark-antiquark pair be separated by distance $R$. In the dual superconducting vacuum picture \cite{silvafilho2026bts3}, the longitudinal chromoelectric field $\mathbf{E}(x)$ generated between the static sources satisfies the dual London equation $\nabla_\perp^2 E_z = (\kappa^*)^2 E_z$ with dual screening mass $m_{\mathrm{dual}} = \kappa^*$. In cylindrical coordinates $(r_\perp, \theta, z)$, the radial profile of the longitudinal chromoelectric field is:
\begin{equation}
    E_z(r_\perp) = E_0 \, K_0(\kappa^* r_\perp)
\end{equation}
where $K_0$ is the modified Bessel function of the second kind. The characteristic transverse core width is $r_{\mathrm{core}} = 1/\kappa^*$.

At the boundary of the reach tube ($r_\perp = r_{\mathrm{core}} = 1/\kappa^*$), the extrinsic boundary curvature of the tubular neighborhood is bounded by the reach $\kappa(r_{\mathrm{core}}) \le \kappa^*$. Matching the non-perturbative chromoelectric energy density to the maximal extrinsic curvature enforced by the Gribov horizon saturates the core field strength at:
\begin{equation}
    E_0 = (\kappa^*)^2
\end{equation}
Integrating the electrostatic field energy over the flux tube cylinder of length $R$:
\begin{equation}
    V(R) = \int_0^R \diff z \int_0^\infty 2\pi r_\perp \diff r_\perp \left( \frac{1}{2} E_z^2(r_\perp) \right) = \left( \pi E_0^2 \int_0^\infty r_\perp K_0^2(\kappa^* r_\perp) \diff r_\perp \right) R
\end{equation}
Using the definite integral $\int_0^\infty x K_0^2(x) \diff x = \frac{1}{2}$, we obtain:
\begin{equation}
    V(R) = \left( \frac{\pi E_0^2}{2 (\kappa^*)^2} \right) R = \left( \frac{\pi (\kappa^*)^4}{2 (\kappa^*)^2} \right) R = \frac{\pi}{2} (\kappa^*)^2 R = \sigma R
\end{equation}
with strictly positive string tension $\sigma = \frac{\pi}{2} (\kappa^*)^2 = \frac{g^2 N}{2\pi} \Lambda_{\mathrm{QCD}}^2 > 0$.

In Euclidean quantum field theory, the expectation value of the Wilson loop operator $\hat{W}(C)$ in the limit $T \to \infty$ is:
\begin{equation}
    \langle W(C) \rangle = \langle \Omega | \hat{W}(R) e^{-\hat{H} T} \hat{W}(R)^\dagger | \Omega \rangle \le C_1 e^{-V(R) T} = C_1 e^{-\sigma R T} = C_1 e^{-\sigma \cdot \mathrm{Area}(C)}
\end{equation}
This rigorously establishes linear quark confinement and the Wilson Area Law with strictly positive string tension $\sigma > 0$.
\end{proof}

\section{Symplectic Floer Homology and Wightman Vacuum Uniqueness}

To establish vacuum uniqueness, let $\mathcal{G}_0 = \{g \in \mathcal{G} : g(x_0) = \mathbf{1}\}$ be the based gauge transformation group. The quotient space $\mathcal{A}/\mathcal{G}_0$ has disconnected components labeled by the winding number $\pi_0(\mathcal{G}/\mathcal{G}_0) \cong \pi_3(G) \cong \mathbb{Z}$, corresponding to the classical topological vacua $\{|n\rangle : n \in \mathbb{Z}\}$.

\begin{theorem}[Symplectic Floer Homology and Vacuum Diagonalization]
On the based gauge orbit space $\mathcal{A}/\mathcal{G}_0$, the Symplectic Floer chain complex $(CF_*(\mathcal{A}/\mathcal{G}_0), \partial_{\mathrm{Floer}})$ possesses a nilpotent differential $\partial_{\mathrm{Floer}}$ counting downward gradient flow trajectories between adjacent winding sectors:
\begin{equation}
    \partial_{\mathrm{Floer}} |n\rangle = |n-1\rangle, \quad \partial_{\mathrm{Floer}}^2 = 0
\end{equation}
where $\partial_{\mathrm{Floer}}^2 = 0$ holds identically by the vanishing of the boundary of the compactified 1-dimensional moduli space of broken trajectories $\partial \overline{\mathcal{M}}(n, n-2) = \emptyset$.

The physical quantum tunneling dynamics is governed by the self-adjoint tunneling Hamiltonian:
\begin{equation}
    \hat{H}_{\mathrm{top}} = E_0 \mathbf{I} - \Delta_{\mathrm{inst}} (\hat{T} + \hat{T}^\dagger)
\end{equation}
where $\hat{T}|n\rangle = |n+1\rangle$ is the unitary large gauge transformation shift operator. The physical $\theta$-vacua:
\begin{equation}
    |\theta\rangle = \sum_{n \in \mathbb{Z}} e^{i n \theta} |n\rangle
\end{equation}
are exact eigenstates of $\hat{H}_{\mathrm{top}}$ with dispersion relation:
\begin{equation}
    \hat{H}_{\mathrm{top}} |\theta\rangle = \left( E_0 - 2 \Delta_{\mathrm{inst}} \cos\theta \right) |\theta\rangle
\end{equation}
At $\theta = 0$, the physical ground state $|\Omega\rangle = |\theta=0\rangle$ is unique, non-degenerate, and separated from all excited states by the strictly positive spectral gap $\Delta > 0$.
\end{theorem}

\begin{proof}
The gradient flow equations of the Chern-Simons functional $\mathrm{CS}(A) = \frac{1}{8\pi^2} \int_\Sigma \Tr\left( A \wedge \diff A + \frac{2}{3} A \wedge A \wedge A \right)$ along the Euclidean time axis $\R \times \Sigma$ are precisely the self-dual instanton equations $F = *F$ \cite{silvafilho2026bts3}.

By the Volume III Floer construction, the instanton moduli space $\mathcal{M}(n, n-1)$ of formal dimension 1 consists of downward flow lines connecting sector $|n\rangle$ to sector $|n-1\rangle$. The directional boundary operator:
\begin{equation}
    \partial_{\mathrm{Floer}} |n\rangle = \sum_{m, \mathrm{ind}(n, m)=1} \#(\mathcal{M}(n, m)/\R) |m\rangle = |n-1\rangle
\end{equation}
satisfies $\partial_{\mathrm{Floer}}^2 |n\rangle = 0$ because the boundary of the compactified 1-dimensional moduli space $\overline{\mathcal{M}}(n, n-2)$ decomposes into pairs of broken trajectories with opposite topological orientations whose signed sum vanishes identically: $\partial \overline{\mathcal{M}}(n, n-2) = 0$.

The physical tunneling dynamics between topological sectors is governed by the self-adjoint tunneling Hamiltonian:
\begin{equation}
    \hat{H}_{\mathrm{top}} = E_0 \mathbf{I} - \Delta_{\mathrm{inst}} (\hat{T} + \hat{T}^\dagger)
\end{equation}
where $\hat{T}$ shifts the winding sector by $+1$ ($\hat{T} |n\rangle = |n+1\rangle$) and its adjoint $\hat{T}^\dagger$ shifts by $-1$ ($\hat{T}^\dagger |n\rangle = |n-1\rangle$).
Acting on the Bloch $\theta$-vacuum $|\theta\rangle = \sum_{n \in \mathbb{Z}} e^{i n \theta} |n\rangle$:
\begin{equation}
    \hat{T} |\theta\rangle = \sum_{n} e^{i n \theta} |n+1\rangle = e^{-i\theta} |\theta\rangle, \quad \hat{T}^\dagger |\theta\rangle = e^{i\theta} |\theta\rangle
\end{equation}
Hence:
\begin{equation}
    \hat{H}_{\mathrm{top}} |\theta\rangle = \left[ E_0 - \Delta_{\mathrm{inst}} (e^{-i\theta} + e^{i\theta}) \right] |\theta\rangle = \left( E_0 - 2\Delta_{\mathrm{inst}} \cos\theta \right) |\theta\rangle =: E(\theta) |\theta\rangle
\end{equation}
Because $\Delta_{\mathrm{inst}} > 0$, the energy eigenvalue $E(\theta)$ attains a unique, strictly non-degenerate global minimum at $\theta = 0$:
\begin{equation}
    E(0) = E_0 - 2\Delta_{\mathrm{inst}} < E(\theta) \quad \text{for all } \theta \ne 0 \pmod{2\pi}
\end{equation}
Since all gauge-invariant glueball and flux-tube excitations above the ground state have energy $E \ge E(0) + \Delta$, the quantum vacuum $|\Omega\rangle = |\theta=0\rangle$ is unique, non-degenerate, and satisfies the Wightman vacuum axiom.
\end{proof}

\section{Reflection Positivity and Vacuum Parity Invariance}

\begin{theorem}[Vafa-Witten Theorem and $\theta=0$ Ground-State Invariance]
In pure $\mathrm{SU}(N)$ quantum Yang-Mills theory, the vacuum energy density $\mathcal{E}(\theta)$ satisfies:
\begin{equation}
    \mathcal{E}(\theta) \ge \mathcal{E}(0) \quad \text{for all } \theta \in [-\pi, \pi]
\end{equation}
with unique global minimum at $\theta = 0$. Consequently, the topological expectation value vanishes identically:
\begin{equation}
    \langle \Tr(F \wedge F) \rangle_{\theta = 0} = 0
\end{equation}
preserving exact CP and parity invariance in the strong interaction ground state.
\end{theorem}

\begin{proof}
Let $\Theta$ be the Euclidean time reflection operator $\Theta(x_0, \mathbf{x}) = (-x_0, \mathbf{x})$. To establish Osterwalder-Schrader reflection positivity on the Gribov modular domain $\Omega$, we employ the local and renormalizable Zwanziger action formulation \cite{zwanziger1989local, vandersickel2012gribov}. The non-local horizon function is localized by introducing auxiliary conjugate Bose fields $(\bar{\phi}_\mu^{ab}, \phi_\mu^{ab})$ and Fermi ghost fields $(\bar{\omega}_\mu^{ab}, \omega_\mu^{ab})$:
\begin{equation}
    S_{\mathrm{local}} = S_{\mathrm{YM}} + S_{\mathrm{gf}} + \int \diff^4x \left( \bar{\phi}_\mu^{ac} (-\mathcal{M}_A)^{cd} \phi_\mu^{ad} - \bar{\omega}_\mu^{ac} (-\mathcal{M}_A)^{cd} \omega_\mu^{ad} + g \gamma_G^2 f^{abc} A_\mu^a (\phi_\mu^{bc} + \bar{\phi}_\mu^{bc}) \right)
\end{equation}
where $\mathcal{M}_A = -D_A^* D_A$ is the Faddeev-Popov operator. Under Euclidean time reflection $\Theta$, the gauge field transforms as $A_0(-x_0, \mathbf{x}) = -A_0(x_0, \mathbf{x})$ and $A_i(-x_0, \mathbf{x}) = A_i(x_0, \mathbf{x})$. Defining the auxiliary field reflections $\Theta \phi_0 = -\phi_0$, $\Theta \phi_i = \phi_i$, $\Theta \omega_0 = \omega_0$, $\Theta \omega_i = -\omega_i$, the total Euclidean action $S_{\mathrm{local}}$ is strictly local, real, and satisfies manifest reflection positivity:
\begin{equation}
    \langle \Theta(F) F \rangle \ge 0 \quad \text{for all functionals } F \in \mathcal{F}_+
\end{equation}
supported in the positive Euclidean half-space $x_0 > 0$ \cite{osterwalder1973axioms, vafawitten1984}.

We emphasize a crucial distinction: while the isolated gauge-variant transverse gluon two-point function in Gribov-Zwanziger theory exhibits complex-conjugate poles violating naive spectral positivity (which is the physical mechanism of gluon confinement, rigorously ensuring that isolated gluons do not appear as asymptotic one-particle states in the physical spectrum), the total localized Euclidean measure $\diff\mu_{\mathrm{local}}$ and all gauge-invariant observable correlation functions (including Wilson loops, color-singlet glueball interpolators, and the topological charge $Q[A]$) satisfy exact Osterwalder-Schrader reflection positivity.

The topological charge $Q[A] = \frac{1}{32\pi^2} \int \Tr(F \tilde{F}) \in \mathbb{Z}$ is odd under time reflection: $\Theta Q[A] = - Q[A]$. The partition function on a 4-torus $T^4$ is:
\begin{equation}
    Z(\theta) = \int \mathcal{D}A \mathcal{D}\phi \mathcal{D}\bar{\phi} \mathcal{D}\omega \mathcal{D}\bar{\omega} \, e^{-S_{\mathrm{local}}} \cos(\theta Q[A])
\end{equation}
Applying the Cauchy-Schwarz inequality for reflection-positive measures:
\begin{equation}
    |Z(\theta)| \le \int \mathcal{D}\mu_{\mathrm{local}} |\cos(\theta Q[A])| \le \int \mathcal{D}\mu_{\mathrm{local}} 1 = Z(0)
\end{equation}
Since the infinite-volume vacuum energy density is $\mathcal{E}(\theta) = - \lim_{V \to \infty} \frac{1}{V} \ln Z(\theta)$, it follows directly that $\mathcal{E}(\theta) \ge \mathcal{E}(0)$ for all $\theta$. Differentiating at $\theta = 0$ yields $\langle Q \rangle_{\theta=0} = 0$, rigorously establishing that the quantum vacuum dynamically preserves CP and parity invariance, resolving the strong CP problem without an axion.
\end{proof}

